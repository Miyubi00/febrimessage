# =============================================================================
# Environment variables
# =============================================================================
# Two groups:
#   1. VITE_*  -> compiled INTO the browser bundle. Public information only.
#   2. no VITE_ -> server-side only (Supabase Edge Functions / local CLI).
#
# NEVER give SUPABASE_SERVICE_ROLE_KEY, RATE_LIMIT_SECRET or CAPTCHA_SECRET a
# `VITE_` prefix. Anything prefixed with `VITE_` is readable by every visitor.
# =============================================================================

# ----------------------------- FRONTEND (public) -----------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Branding (optional)
VITE_SITE_NAME=AnonMessage

# Optional: hCaptcha / Turnstile *site* key. Leave empty to disable captcha.
# The matching secret must stay server-side (CAPTCHA_SECRET below).
VITE_CAPTCHA_SITE_KEY=
# hcaptcha | turnstile  (must match CAPTCHA_PROVIDER on the server)
VITE_CAPTCHA_PROVIDER=hcaptcha

# -------------------------- SERVER-SIDE ONLY (secret) ------------------------
# Used by Supabase Edge Functions. Bypasses RLS — never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Salt used to hash visitor IP addresses before they touch the database.
# Changing this value invalidates every stored ip_hash.
RATE_LIMIT_SECRET=change-me-to-a-long-random-string

# Captcha verification secret (only required when captcha is enabled).
CAPTCHA_SECRET=
# hcaptcha | turnstile | disabled
CAPTCHA_PROVIDER=disabled

# Discord webhook for "Pesan Baru" notifications (server-side only).
# RECOMMENDED: paste the URL in the admin Settings page instead — it is stored
# in the app_settings table (admin-readable, superadmin-writable, validated
# server-side) and takes effect without a redeploy.
# This secret is only a fallback used when app_settings.discord_webhook_url is
# empty. Never give it a VITE_ prefix.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --------------------------- LOCAL SUPABASE CLI ------------------------------
# Used by `supabase functions serve --env-file .env` and by the local stack.
# (Also exposed to the frontend as PUBLIC keys.)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key